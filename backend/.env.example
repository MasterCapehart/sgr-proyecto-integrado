# Plantilla compartida. Copiar a .env y configurar cada equipo; no subir credenciales.
SECRET_KEY=reemplazar_por_una_clave_local_aleatoria
DEBUG=True
DB_NAME=sgr_db
DB_USER=root
DB_PASSWORD=reemplazar_por_la_clave_de_tu_mysql
DB_HOST=localhost
DB_PORT=3306

# local: buzón privado en .local-mail. smtp: envío real con el proveedor elegido.
# Mantener local hasta completar los datos SMTP en backend/.env, nunca en Git.
SGR_EMAIL_MODE=local
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmail: contraseña de aplicación, nunca la contraseña habitual.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

ALLOWED_HOSTS=127.0.0.1,localhost
