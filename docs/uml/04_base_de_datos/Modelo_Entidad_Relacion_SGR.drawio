        <mxCell id="nr_db_relations" value="&lt;b&gt;Referencias a entidades existentes&lt;/b&gt;&lt;br&gt;Pertenencia.id_persona → PersonaSolicitante.id_persona (1:N).&lt;br&gt;Organización/Hito → Territorio y Delegación (N:1).&lt;br&gt;AsignaciónHito/Ausencia/CupoDiario → Funcionario (N:1).&lt;br&gt;Usuarios creadores/validadores/asignadores → Usuario (N:1).&lt;br&gt;ReglaElegibilidad.id_tipo_actividad → ValorCatalogo (N:1).&lt;br&gt;Felicitación.id_persona_emisor → PersonaSolicitante (N:1)." vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFDF2;strokeColor=#C8A951;fontSize=14;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry as="geometry" x="1840" y="4280" width="1700" height="260" />
        </mxCell>
        <mxCell id="nr_db_activity" value="&lt;b&gt;Actividad · continuación de la misma entidad&lt;/b&gt;&lt;br&gt;FK id_hito (opcional); FK id_asignacion_hito (opcional); FK id_regla_elegibilidad.&lt;br&gt;origen_interno_externo; beneficiario_delegado; motivo_sin_aporte.&lt;br&gt;fecha_actividad y creado_en existentes distinguen realización de registro.&lt;br&gt;Sin vecino/nombre/teléfono: conservar registro, aporte cero; referencia a persona opcional para actividad interna." vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFDF2;strokeColor=#C8A951;fontSize=14;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry as="geometry" x="80" y="4910" width="1660" height="220" />
        </mxCell>
        <mxCell id="nr_db_rules" value="&lt;b&gt;Restricciones y cálculo implementados&lt;/b&gt;&lt;br&gt;Vínculo vecino–organización único y reactivable. Reserva concurrente: siete candidatas/autor/fecha. Tres fechas inclusivas; tardío conservado sin aporte. Meta por disponibilidad exacta; reconocido limitado al 120%. R13 consolida resultados y cierres, sin tablas de tablero ni metas territoriales. Esquema lógico; nombres no equivalen al modelo físico." vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFDF2;strokeColor=#C8A951;fontSize=14;align=left;verticalAlign=top;spacing=12;">
          <mxGeometry as="geometry" x="1840" y="4910" width="1700" height="260" />
        </mxCell>
