        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#111111;" value="DIAGRAMA GENERAL DE REQUERIMIENTOS — SISTEMA SGR" vertex="1">
          <mxGeometry height="45" width="1150" x="250" y="20" as="geometry" />
        </mxCell>
        <mxCell id="req000" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=17;fontStyle=0;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;shadow=0;" value="&lt;b&gt;REQ-000 · Sistema de Gestión de Resultados&lt;/b&gt;&lt;br&gt;&lt;br&gt;Centralizar el registro, seguimiento, validación, medición y consulta de la gestión de las Delegaciones Municipales de La Serena." vertex="1">
          <mxGeometry height="120" width="720" x="420" y="85" as="geometry" />
        </mxCell>
        <mxCell id="functional" parent="1" style="swimlane;horizontal=1;startSize=60;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#2F2F2F;fontColor=#111111;fontSize=17;spacing=10;strokeWidth=1.8;shadow=0;" value="&lt;b&gt;REQUERIMIENTOS FUNCIONALES&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Ocho épicas originales + complementos de la segunda evaluación&lt;/font&gt;" vertex="1">
          <mxGeometry height="850" width="1080" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="ep01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-01 · Registro y gestión de actividades&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-01 a HU-04&lt;/font&gt;&lt;br&gt;&lt;br&gt;Registrar actividades y atención: solicitante, tipo/subatención compatibles, descripción y contexto autorizado; fecha y responsable automáticos; sin duplicación." vertex="1">
          <mxGeometry height="160" width="480" x="80" y="350" as="geometry" />
        </mxCell>
        <mxCell id="ep02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-02 · Medición y desempeño&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-05 a HU-08&lt;/font&gt;&lt;br&gt;&lt;br&gt;Administrar ítems, metas y ponderaciones; fórmulas y topes configurables; calcular avance aprobado y cumplimiento individual/colectivo." vertex="1">
          <mxGeometry height="160" width="480" x="600" y="350" as="geometry" />
        </mxCell>
        <mxCell id="ep03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-03 · Evidencias y verificación&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-09 a HU-11&lt;/font&gt;&lt;br&gt;&lt;br&gt;Adjuntar, consultar y validar evidencias; conservar versiones y decisiones; evitar aportes duplicados y proteger los archivos." vertex="1">
          <mxGeometry height="160" width="480" x="80" y="540" as="geometry" />
        </mxCell>
        <mxCell id="ep04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-04 · Agenda colectiva y compromisos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-12 a HU-15&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gestionar compromisos, responsables, plazos, estados e historial; reasignar y validar cierre; conservar conteos únicos." vertex="1">
          <mxGeometry height="160" width="480" x="600" y="540" as="geometry" />
        </mxCell>
        <mxCell id="ep05" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-05 · Monitoreo y control&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-16 a HU-19&lt;/font&gt;&lt;br&gt;&lt;br&gt;Mostrar semáforos, alertas, avances e históricos; aplicar calendario, umbrales y reglas vigentes aprobadas." vertex="1">
          <mxGeometry height="160" width="480" x="80" y="730" as="geometry" />
        </mxCell>
        <mxCell id="ep06" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-06 · Reportabilidad y toma de decisiones&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-20 a HU-22&lt;/font&gt;&lt;br&gt;&lt;br&gt;Buscar por coincidencia parcial, combinar filtros y paginar; exportar a Excel todo el conjunto autorizado filtrado." vertex="1">
          <mxGeometry height="160" width="480" x="600" y="730" as="geometry" />
        </mxCell>
        <mxCell id="ep07" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-07 · Plataforma colaborativa&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-23 a HU-25&lt;/font&gt;&lt;br&gt;&lt;br&gt;Acceso web y trabajo simultáneo; detectar conflictos de versión y conservar datos sin sobrescritura silenciosa." vertex="1">
          <mxGeometry height="160" width="480" x="80" y="920" as="geometry" />
        </mxCell>
        <mxCell id="ep08" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontSize=14;spacing=10;align=left;verticalAlign=top;strokeWidth=1.5;shadow=0;" value="&lt;b&gt;EP-08 · Administración, seguridad y trazabilidad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;HU-26 a HU-31&lt;/font&gt;&lt;br&gt;&lt;br&gt;Acceder y recuperar contraseña por código. CRUD de Delegaciones, Roles, Usuarios, Ítems/metas, Tipo y Sub Atención; permisos por delegación e historial." vertex="1">
          <mxGeometry height="160" width="480" x="600" y="920" as="geometry" />
