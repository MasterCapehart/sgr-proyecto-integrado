DJANGO_SETTINGS_MODULE=config.settings_production
SGR_LOAD_DOTENV=False
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_EXCLUSIVA
DEBUG=False
ALLOWED_HOSTS=IP_PUBLICA_ESTABLE
CSRF_TRUSTED_ORIGINS=https://IP_PUBLICA_ESTABLE
DB_NAME=sgr_prueba
DB_HOST=ENDPOINT_RDS
DB_PORT=3306
DB_USER=sgr_app
DB_PASSWORD=REEMPLAZAR
RDS_CA_PATH=/etc/sgr/rds-ca.pem
AWS_STORAGE_BUCKET_NAME=BUCKET_PRIVADO
AWS_REGION=us-east-1
SGR_EMAIL_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=REEMPLAZAR
EMAIL_HOST_PASSWORD=REEMPLAZAR
DEFAULT_FROM_EMAIL=REEMPLAZAR
SESSION_COOKIE_NAME=sgr_aws_session
CSRF_COOKIE_NAME=sgr_aws_csrf
