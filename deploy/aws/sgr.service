[Unit]
Description=SGR Django Gunicorn
After=network-online.target
Wants=network-online.target

[Service]
User=sgr
Group=sgr
WorkingDirectory=/srv/sgr/app/backend
EnvironmentFile=/etc/sgr/sgr.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/sgr/app/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 90 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
