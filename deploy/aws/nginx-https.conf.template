# Sustituir PUBLIC_IP. Certificado IP de Let's Encrypt con renovación automática.
server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://PUBLIC_IP$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/sgr/app/frontend;
    index index.html;
    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=3600" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location /static/ { alias /srv/sgr/app/staticfiles/; }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ =404; }
}
